{
  "name": "ttalk-bot-manager",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hosted WhatsApp bot manager (Baileys): wait for the first message, ask questions, collect files and store them safely on your server.",
  "license": "MIT",
  "author": "Gustavo Hudson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GustavoHuds/Ttalk_bot_manager.git"
  },
  "homepage": "https://github.com/GustavoHuds/Ttalk_bot_manager#readme",
  "bugs": "https://github.com/GustavoHuds/Ttalk_bot_manager/issues",
  "keywords": [
    "whatsapp",
    "baileys",
    "whatsapp-bot",
    "recruitment",
    "chatbot",
    "self-hosted",
    "lgpd",
    "typescript",
    "sqlite",
    "fastify"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "senha": "tsx scripts/gerar-senha.ts",
    "restaurar-backup": "tsx scripts/restaurar-backup.ts",
    "capturas": "tsx scripts/gerar-capturas.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "9.0.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "nodemailer": "10.0.15",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "tar": "7.5.22",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
