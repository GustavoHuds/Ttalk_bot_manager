# Nome da empresa, usado como {empresa} nas mensagens do bot
EMPRESA_NOME=Minha Empresa

# Pastas (relativas à raiz do projeto)
DADOS_DIR=./data
CONFIG_DIR=./config

# Painel (fica atrás do proxy reverso com HTTPS)
PAINEL_HOST=127.0.0.1
PAINEL_PORTA=3100
# Segredo para assinar o cookie de sessão (mínimo 32 caracteres aleatórios)
PAINEL_SEGREDO=
# Usuários: nome:hash separados por ";" — gere o hash com `npm run senha`
PAINEL_USUARIOS=
# Deixe true em produção (HTTPS). Use false só para testar em http://localhost
PAINEL_COOKIE_SEGURO=true

# Janela de resposta: o bot só responde a mensagens recebidas há no máximo N horas
JANELA_RESPOSTA_HORAS=24

# Backup diário cifrado (sem senha, o backup fica desativado)
BACKUP_SENHA=
BACKUP_RETENCAO_DIAS=365

# Alerta por e-mail quando a conexão cai (opcional)
# Ex.: smtps://usuario:senha@smtp.gmail.com:465
SMTP_URL=
ALERTA_EMAIL_DE=
ALERTA_EMAIL_PARA=

LOG_NIVEL=info
